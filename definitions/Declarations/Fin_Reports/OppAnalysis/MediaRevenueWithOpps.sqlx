-------------------------------------------------------------------
EXECUTE IMMEDIATE SQL3;

-- SELECT * FROM RevByYear
-- ORDER BY 
--   parent_name
--   ,revenue_item
--   ,primary_opp_close_date;
-------------------------------------------------------------------

EXECUTE IMMEDIATE SQL4;

CREATE OR REPLACE TABLE `adswerve-finance.Fin_Reports.MediaRevenueWithOpps_DetailData` AS 
SELECT * FROM MediaOppRevAnalysis_Detail
ORDER BY 
  parent_name
  ,revenue_item
  ,primary_opp_close_date;
-------------------------------------------------------------------
EXECUTE IMMEDIATE SQL5;

CREATE OR REPLACE TABLE `adswerve-finance.Fin_Reports.MediaRevenueWithOpps_ChartData` AS 
SELECT * FROM MediaOppRevAnalysis_Charts
WHERE
  opportunity_value IS NOT NULL
  AND opportunity_value <> 0
ORDER BY 
  parent_name
  ,revenue_item
  ,primary_opp_close_date;

